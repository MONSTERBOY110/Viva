# Viva environment variables. Copy to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real keys.
#
# Viva runs with none of these set: the engine falls back to a deterministic
# interviewer and an in memory session store. Each key upgrades one layer.

# Gemini (Google AI Studio), the interview engine LLM
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_THINKING_BUDGET=0

# Upstash Redis (Vercel Marketplace), serverless session state
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Breeth (sponsor), long term candidate memory, feature flagged
BREETH_API_KEY=your-breeth-api-key
BREETH_ENABLED=false

# ElevenLabs, the spoken examiner. Set the key and Viva conducts the viva
# aloud: it streams its questions in a real voice and listens to the answer.
# The controls are hidden entirely when this is not configured, and every
# failure path falls back to silence, so the interview never depends on it.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Present key means on. Set this to false to keep voice installed but silent.
# ELEVENLABS_ENABLED=false
# Optional overrides. The default voice is George, a warm British narrator,
# and the voice picker is populated from your account at runtime.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_flash_v2_5
