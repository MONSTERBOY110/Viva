# Viva environment variables — copy to .env.local and fill in real values.
# .env.local is gitignored; NEVER commit real keys.

# Gemini (Google AI Studio) — interview engine LLM
GEMINI_API_KEY=your-gemini-api-key

# Upstash Redis (Vercel Marketplace) — serverless session state
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Breeth (sponsor) — long-term candidate memory, feature-flagged
BREETH_API_KEY=your-breeth-api-key
BREETH_ENABLED=false
